# Copy to .env for local use. Choose a private value at least 20 characters long.
ADMIN_PASSWORD=00e8d45b792bfa9f24b213c351c1b2f5

# Set both values to use Supabase instead of local SQLite.
SUPABASE_URL=00e8d45b792bfa9f24b213c351c1b2f5
SUPABASE_SECRET_KEY=00e8d45b792bfa9f24b213c351c1b2f5

# When the frontend is deployed separately on Vercel, add its exact origin here in Render.
FRONTEND_ORIGIN=will-you-go-on-a-date-with-me-sepia.vercel.app

# On Vercel, set this to the Render service's base URL (no trailing slash).
VITE_API_BASE_URL=https://your-service.onrender.com

# Optional for local SQLite only, or when using SQLite with a persistent disk.
DATA_DIR=./data
